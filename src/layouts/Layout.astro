---
// src/layouts/Layout.astro
import '../styles/global.css';

export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  keywords?: string;
  ogImage?: string;
  type?: string;
  faqItems?: FaqItem[];
}

export const defaultFaqs: FaqItem[] = [
  {
    question: "How do I crop Meesho shipping labels for 4x6 thermal printers for free?",
    answer: "Simply drag and drop your downloaded Meesho A4 invoice PDF into SmartLabelCrop.in. The tool automatically detects label boundaries, removes bottom tax invoice whitespace, resizes the vector barcode to exact 4x6 inch (100x150 mm) dimensions, and rescues your SKU and size into an enlarged 72pt footer."
  },
  {
    question: "Why does the Meesho SKU disappear below the fold line on thermal prints?",
    answer: "Meesho prints buyer delivery addresses with variable line lengths followed by a Tax Invoice divider. On 4x6 thermal printers (288x432 pt), the critical item SKU and apparel size get cut off below the fold line. SmartLabelCrop's dynamic fold-line parser rescues the SKU and size, stamping them in an enlarged bold footer at the bottom."
  },
  {
    question: "How does the Inverted Black Multi-Order Alert stop ₹300-₹500 RTO losses?",
    answer: "Whenever a buyer orders quantity >= 2, Meesho only prints a tiny 'Qty: 2' in faint 6pt text. Packing staff in busy warehouses routinely miss it and ship 1 piece, leading to customer disputes and ₹300-₹500 RTO deductions. SmartLabelCrop automatically stamps a solid black banner: '[★ MULTI-ORDER: PACK X PCS ★]'."
  },
  {
    question: "Why do thermal barcodes from generic online croppers fail to scan?",
    answer: "Generic online croppers convert PDF pages into HTML5 canvas raster images (PNG/JPEG) before printing. On 203 DPI thermal printers, rasterized barcode lines blur. SmartLabelCrop preserves 100% native PDF vector paths, guaranteeing razor-sharp scans on Valmo, Ekart, and Delhivery handheld barcode guns."
  },
  {
    question: "Which thermal printers and drivers are supported?",
    answer: "SmartLabelCrop is calibrated for all major thermal printers used by Indian sellers, including TVS LP-46 / 46 Neo (Seagull Driver, Darkness 11-12), TSC TE-244 / TE-200, Zebra ZD230 / GC420t, and Xprinter XP-420B / XP-460B."
  },
  {
    question: "Is buyer PII and GSTIN data secure and DPDP Act 2023 compliant?",
    answer: "Yes, 100%. SmartLabelCrop processes all files purely in-memory using WebAssembly inside your browser tab. Zero buyer names, phone numbers, addresses, GSTIN numbers, or sales volumes are ever transmitted to any remote cloud server, ensuring full compliance with the Digital Personal Data Protection (DPDP) Act 2023."
  },
  {
    question: "How does courier sorting work for Valmo Express, Ekart Logistics, and Delhivery?",
    answer: "SmartLabelCrop features an Apparel-Aware 4-Key Sorter that sorts your batch hierarchically: Courier Partner Handover (Valmo Express -> Ekart -> Delhivery -> Shadowfax) -> SKU -> Apparel Size (XXS -> 3XL) -> Order ID. This groups packages for efficient 6 PM courier handovers."
  },
  {
    question: "Can I convert Meesho or Flipkart Excel order reports into a warehouse picklist?",
    answer: "Yes! Use our standalone Excel Order Picklist feature. Drop your Meesho 'Pending Orders' CSV or Excel report, and our tool automatically aggregates total units needed by SKU, size, and color, and prints a 4x6 thermal picklist sticker or printable pull sheet."
  },
  {
    question: "Is SmartLabelCrop completely free or is there a catch?",
    answer: "SmartLabelCrop.in is 100% free forever. There are zero subscriptions, no daily order limits, no account sign-ups, and no watermarks stamped onto your labels."
  },
  {
    question: "Does SmartLabelCrop work offline or without internet?",
    answer: "Yes! Because the core PDF parsing and vector cropping engine is powered by client-side WebAssembly, once the application loads in your browser, you can crop labels and generate picklists even if your internet connection drops."
  }
];

const {
  title = "Meesho Label Cropper 4x6 Free Online | SmartLabelCrop.in",
  description = "Free online Meesho & Flipkart 4x6 thermal label cropper. Rescues hidden SKUs from fold lines, stamps inverted black multi-order pack alerts, and generates courier picklists with 100% vector barcode clarity.",
  canonicalUrl = "https://smartlabelcrop.in",
  keywords = "meesho label cropper, meesho label crop 4x6, flipkart label cropper, meesho shipping label crop online free, thermal label cropper online, meesho label resize for thermal printer, meesho 4x6 label cropper, shopsy label crop 4x6, meesho sku rescuer label cropper, meesho multi order pack alert, valmo courier label cropper, meesho picklist generator 4x6, free shipping label cropper for meesho flipkart",
  ogImage = "https://smartlabelcrop.in/og-image.png",
  type = "website",
  faqItems = defaultFaqs
} = Astro.props;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "SmartLabelCrop.in",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "All (Web Browser WebAssembly)",
  "url": canonicalUrl,
  "description": description,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "INR"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "1280",
    "bestRating": "5"
  }
};

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "SmartLabelCrop.in",
  "url": "https://smartlabelcrop.in",
  "logo": "https://smartlabelcrop.in/favicon.svg",
  "sameAs": [
    "https://github.com/manish2007ux896/label"
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<!doctype html>
<html lang="en" class="scroll-smooth scroll-pt-20">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="SmartLabelCrop.in Team" />
    <meta name="geo.region" content="IN" />
    <meta name="geo.placename" content="India" />

    <!-- Open Graph (Facebook, WhatsApp, LinkedIn) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="SmartLabelCrop.in" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter Card Meta -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Mobile & PWA Experience -->
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="application-name" content="SmartLabelCrop.in" />
    <meta name="apple-mobile-web-app-title" content="SmartLabelCrop" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <!-- Client-Side Theme Detection Script -->
    <script is:inline>
      (function() {
        const stored = typeof localStorage !== 'undefined' ? localStorage.getItem('theme') : null;
        const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-canvas text-ink selection:bg-accent selection:text-white flex flex-col font-sans">
    <slot />
  </body>
</html>
