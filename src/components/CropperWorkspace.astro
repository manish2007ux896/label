  const scannedAwbs = new Set<string>();

  function updateVerifyStats() {
    if (!currentBatchResult) return;
    const total = currentBatchResult.activeLabels.length;
    const scanned = scannedAwbs.size;
    const remaining = Math.max(0, total - scanned);

    if (verifyStatTotal) verifyStatTotal.textContent = total.toString();
    if (verifyStatScanned) verifyStatScanned.textContent = scanned.toString();
    if (verifyStatRemaining) verifyStatRemaining.textContent = remaining.toString();

    if (verifyStatusBanner) {
      if (scanned === total && total > 0) {
        verifyStatusBanner.textContent = '🎉 100% BATCH VERIFIED! Ready for Handover';
        verifyStatusBanner.className = 'text-emerald-600 dark:text-emerald-400 font-bold';
        playBatchSuccessSound();
      } else {
        verifyStatusBanner.textContent = `${remaining} parcels pending scan`;
        verifyStatusBanner.className = 'text-purple-600 dark:text-purple-400 font-bold';
      }
    }
  }

  function handleBarcodeScan(rawCode: string) {
    if (!currentBatchResult) {
      alert('Please process a batch of labels first.');
      return;
    }
    const clean = rawCode.trim().toUpperCase();
    if (!clean) return;

    // Check if clean AWB matches any label in the batch
    const match = currentBatchResult.activeLabels.find(l => 
      l.awbNumber.toUpperCase() === clean || 
      l.orderId.toUpperCase() === clean ||
      (l.subOrderNo && l.subOrderNo.toUpperCase() === clean)
    );

    if (!match) {
      playDuplicateWarningSound();
      alert(`AWB '${clean}' was NOT found in this batch!`);
      return;
    }

    if (scannedAwbs.has(match.awbNumber)) {
      playDuplicateWarningSound();
      alert(`AWB '${match.awbNumber}' was ALREADY scanned and verified!`);
      return;
    }

    // New verification
    scannedAwbs.add(match.awbNumber);
    playScanBeepSound();

    if (verifyFeed) {
      const row = document.createElement('div');
      row.className = 'flex items-center justify-between p-2 bg-emerald-50/60 dark:bg-emerald-950/30 text-emerald-900 dark:text-emerald-200 rounded';
      const timeStr = new Date().toLocaleTimeString('en-IN', { timeStyle: 'medium' });
      row.innerHTML = `
        <div class="flex items-center gap-2">
          <span class="text-emerald-600 dark:text-emerald-400 font-bold">✓</span>
          <span class="font-bold">${match.awbNumber}</span>
          <span class="text-neutral-500 text-[10px]">(${match.courier} | ${match.sku})</span>
        </div>
        <span class="text-[10px] text-neutral-400">${timeStr}</span>
      `;
      if (verifyFeed.children.length === 1 && verifyFeed.children[0].textContent?.includes('Ready!')) {
        verifyFeed.innerHTML = '';
      }
      verifyFeed.prepend(row);
    }

    updateVerifyStats();
  }

