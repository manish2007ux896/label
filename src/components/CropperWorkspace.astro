        r.totalPackets
      ].join(','));
      const csvStr = '\uFEFF' + headers.join(',') + '\r\n' + rows.join('\r\n');
      const blob = new Blob([csvStr], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `SmartLabelCrop_Picklist_Summary_${currentReportResult.totalUnits}units.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });
  }

  // Trigger download
  if (btnDownloadPdf) {
    btnDownloadPdf.addEventListener('click', async () => {
      if (!currentBatchResult) return;

      const blob = new Blob([currentBatchResult.outputPdfBytes], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `SmartLabelCrop_${currentBatchResult.batchCode}_${currentBatchResult.activeLabels.length}_Labels.pdf`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);

      // Record to IndexedDB to activate 30-day deduplication protection
      await recordPrintedAwbsLocal(currentBatchResult.activeLabels, currentBatchResult.batchCode);
    });
  }

  // Direct print
  if (btnDirectPrint) {
    btnDirectPrint.addEventListener('click', () => {
      if (!currentBatchResult) return;
      const blob = new Blob([currentBatchResult.outputPdfBytes], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      const printWindow = window.open(url);
      if (printWindow) {
        printWindow.addEventListener('load', () => {
          printWindow.print();
        });
      }
    });
  }

  // Reset
  if (btnReset) {
    btnReset.addEventListener('click', () => {
      currentBatchResult = null;
      rawUploadedFiles = [];
      diagnosticsPanel.classList.add('hidden');
      if (fileInput) fileInput.value = '';
    });
  }

  // Re-run on option changes
  [selectSort, checkPicklist, checkStampSku].forEach(el => {
    if (el) el.addEventListener('change', () => {
      if (rawUploadedFiles.length > 0) {
        executeBatchProcessing();
      }
    });
  });

  const outputRadios = document.querySelectorAll('input[name="opt-output"]');
  outputRadios.forEach(r => {
    r.addEventListener('change', () => {
      if (rawUploadedFiles.length > 0) {
        executeBatchProcessing();
      }
    });
  });
</script>
