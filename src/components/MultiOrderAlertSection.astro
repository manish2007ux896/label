---
// src/components/MultiOrderAlertSection.astro
---

<section id="multi-alert" class="py-16 sm:py-20 bg-white dark:bg-[#0A0A0A] border-b border-border dark:border-neutral-800 transition-colors scroll-mt-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Text Description -->
      <div class="lg:col-span-6 space-y-5">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-[2px] bg-[#EA580C]"></span>
          <span class="text-xs font-semibold uppercase tracking-wider text-[#525252] dark:text-neutral-400">Financial Loss Prevention</span>
        </div>
        
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#0A0A0A] dark:text-white font-display">
          Stop Losing ₹300 On Every Missed Multi-Quantity Order
        </h2>

        <p class="text-sm sm:text-base text-[#525252] dark:text-neutral-400 leading-relaxed font-body">
          On Meesho, multi-quantity orders hide the quantity in a tiny 6-point font inside the bottom tax invoice table. When packing 100+ orders during evening dispatch, workers easily pack only 1 kurti instead of 2.
        </p>

        <div class="rounded-lg border border-orange-200 dark:border-orange-900/60 bg-orange-50/50 dark:bg-orange-950/20 p-4">
          <div class="text-xs font-bold text-[#EA580C] uppercase tracking-wide">The Cost of 1 Missed Item:</div>
          <div class="mt-1 text-xs text-orange-950 dark:text-orange-200/90 space-y-1">
            <div class="flex items-center justify-between">
              <span>Customer Missing Item Claim & RTO:</span>
              <span class="font-mono font-semibold">₹150 forward + ₹150 reverse freight</span>
            </div>
            <div class="flex items-center justify-between font-bold border-t border-orange-200/60 dark:border-orange-900/40 pt-1 text-[#EA580C]">
              <span>Direct Net Loss to Seller:</span>
              <span class="font-mono text-sm">₹300 - ₹500 per error</span>
            </div>
          </div>
        </div>

        <ul class="space-y-3 text-xs sm:text-sm text-neutral-700 dark:text-neutral-300 font-body">
          <li class="flex items-start gap-2.5">
            <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-black dark:bg-white text-[10px] text-white dark:text-black">✓</span>
            <span><strong>Inverted Black Header Banner:</strong> Any order with qty ≥ 2 is stamped with an unmissable solid black banner with white text across the label top.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-black dark:bg-white text-[10px] text-white dark:text-black">✓</span>
            <span><strong>Rescued Bottom Details:</strong> Size (e.g. <span class="font-mono font-bold text-black dark:text-white">XL</span>), Color (<span class="font-mono font-bold text-black dark:text-white">BLACK</span>), and Total Pieces are enlarged to 12pt bold right at the fold line.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-black dark:bg-white text-[10px] text-white dark:text-black">✓</span>
            <span><strong>Batch Risk Metric:</strong> Your dashboard instantly flags how many multi-piece orders are in your batch before you print a single sticker.</span>
          </li>
        </ul>
      </div>

      <!-- Visual Preview of Inverted Black Banner -->
      <div class="lg:col-span-6">
        <div class="rounded-2xl border border-neutral-300 dark:border-neutral-800 bg-[#FAFAFA] dark:bg-[#111111] p-6 shadow-sm">
          <div class="text-xs font-mono text-neutral-400 dark:text-neutral-500 mb-3 text-center">
            SAMPLE 4×6 THERMAL STICKER OUTPUT (288×432 PT)
          </div>

          <!-- Thermal Sticker Mockup -->
          <div class="mx-auto max-w-[320px] rounded-lg border-2 border-dashed border-neutral-400 bg-white p-4 shadow-md font-mono text-left select-none text-black">
            
            <!-- STAMPED INVERTED BLACK BANNER -->
            <div class="rounded bg-black p-2 text-center text-white shadow-xs">
              <div class="text-xs font-black tracking-widest text-[#EA580C]">
                ★ MULTI-ORDER: PACK 2 PCS ★
              </div>
              <div class="text-[9px] text-neutral-300 mt-0.5">
                VERIFY PACK COUNT BEFORE SEALING POLYBAG
              </div>
            </div>

            <!-- Simulated Meesho Shipping Header -->
            <div class="mt-3 flex items-center justify-between border-b border-black pb-2 text-[10px]">
              <div>
                <span class="font-bold text-base">VALMO</span>
                <div class="text-neutral-500">Surface Express</div>
              </div>
              <div class="text-right">
                <div class="font-bold">COD: ₹699</div>
                <div class="text-neutral-500">Routing: SUR/AMD</div>
              </div>
            </div>

            <!-- Simulated Barcode Lines -->
            <div class="my-3 flex flex-col items-center">
              <div class="flex h-12 w-full items-center justify-center gap-0.5 px-2 bg-neutral-100/50 py-1">
                <span class="h-10 w-1 bg-black"></span>
                <span class="h-10 w-0.5 bg-black"></span>
                <span class="h-10 w-2 bg-black"></span>
                <span class="h-10 w-0.5 bg-black"></span>
                <span class="h-10 w-1 bg-black"></span>
                <span class="h-10 w-3 bg-black"></span>
                <span class="h-10 w-0.5 bg-black"></span>
                <span class="h-10 w-1.5 bg-black"></span>
                <span class="h-10 w-0.5 bg-black"></span>
                <span class="h-10 w-2 bg-black"></span>
                <span class="h-10 w-1 bg-black"></span>
                <span class="h-10 w-0.5 bg-black"></span>
                <span class="h-10 w-2.5 bg-black"></span>
              </div>
              <span class="mt-1 text-[11px] font-bold tracking-wider text-black">AWB: VL9028192019</span>
            </div>

            <!-- Address lines -->
            <div class="border-t border-neutral-300 pt-2 text-[9px] text-neutral-700 leading-tight">
              <div><strong>Ship To:</strong> Priya Sharma, Flat 402, Shivam Apts</div>
              <div>Surat, Gujarat - <strong class="text-black">395006</strong></div>
            </div>

            <!-- RESCUED FOOTER STAMP -->
            <div class="mt-4 rounded border-2 border-black bg-neutral-50 p-2 text-black">
              <div class="flex items-center justify-between text-xs font-black">
                <span class="truncate">SKU: KRT-COT-BLK-XL</span>
                <span class="rounded bg-black px-1.5 py-0.5 text-white">SIZE: XL</span>
              </div>
              <div class="mt-1 flex items-center justify-between text-[10px] text-neutral-700 font-semibold">
                <span>COLOR: BLACK</span>
                <span class="text-[#EA580C] font-black">TOTAL QTY: 2 PCS</span>
              </div>
            </div>

            <div class="mt-2 text-center text-[8px] text-neutral-500 font-sans">
              ★ PLEASE RECORD UNBOXING VIDEO FOR ANY RETURN CLAIMS ★
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>
