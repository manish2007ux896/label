---
// src/components/Navbar.astro
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = currentPath === '/';
const isMeesho = currentPath === '/meesho-label-cropper';
const isFlipkart = currentPath === '/flipkart-label-cropper';
const isPicklist = currentPath === '/meesho-picklist-generator';
const isManifest = currentPath === '/meesho-excel-to-manifest';
const isToolsActive = isPicklist || isManifest;
---

<header class="sticky top-0 z-50 w-full border-b border-border bg-white/95 dark:bg-[#0A0A0A]/95 backdrop-blur-md transition-colors">
  <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    
    <!-- Brand -->
    <div class="flex items-center gap-4 xl:gap-8">
      <a href="/" class="flex items-center gap-2 group shrink-0">
        <img src="/favicon.svg" alt="SmartLabelCrop.in Logo" class="h-7 w-7 rounded-[7px] shadow-2xs group-hover:scale-105 transition-transform" />
        <span class="text-base font-bold tracking-tight text-[#0A0A0A] dark:text-white whitespace-nowrap">
          SmartLabelCrop<span class="text-[#EA580C]">.in</span>
        </span>
      </a>

      <!-- Desktop Navigation Pills (Guaranteed Single-Line, Never Wraps) -->
      <nav class="hidden lg:flex items-center gap-1 text-xs font-medium text-neutral-600 dark:text-neutral-400">
        
        <!-- Meesho -->
        <a
          href={isMeesho ? "#cropper" : "/meesho-label-cropper"}
          class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md transition-colors whitespace-nowrap shrink-0 ${
            isMeesho
              ? 'bg-neutral-100 dark:bg-neutral-800 text-neutral-900 dark:text-white font-semibold'
              : 'hover:text-[#0A0A0A] dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800/80'
          }`}
          title="Free Meesho 4x6 Thermal Label Cropper"
        >
          {isMeesho && <span class="h-1.5 w-1.5 rounded-full bg-[#EA580C] shrink-0"></span>}
          <span>Meesho</span>
        </a>

        <!-- Flipkart / Shopsy -->
        <a
          href={isFlipkart ? "#cropper" : "/flipkart-label-cropper"}
          class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md transition-colors whitespace-nowrap shrink-0 ${
            isFlipkart
              ? 'bg-neutral-100 dark:bg-neutral-800 text-neutral-900 dark:text-white font-semibold'
              : 'hover:text-[#0A0A0A] dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800/80'
          }`}
          title="Flipkart & Shopsy 4x6 Label Cropper"
        >
          {isFlipkart && <span class="h-1.5 w-1.5 rounded-full bg-blue-500 shrink-0"></span>}
          <span>Flipkart / Shopsy</span>
        </a>

        <!-- Tools Dropdown (Picklist & Manifest) -->
        <div class="relative group/dropdown">
          <button
            type="button"
            class={`inline-flex items-center gap-1 px-3 py-1.5 rounded-md transition-colors whitespace-nowrap shrink-0 cursor-pointer ${
              isToolsActive
                ? 'bg-neutral-100 dark:bg-neutral-800 text-neutral-900 dark:text-white font-semibold'
                : 'hover:text-[#0A0A0A] dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800/80'
            }`}
          >
            {isToolsActive && <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 shrink-0"></span>}
            <span>Tools</span>
            <svg class="h-3 w-3 text-neutral-400 group-hover/dropdown:text-neutral-600 dark:group-hover/dropdown:text-neutral-300 transition-transform group-hover/dropdown:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Dropdown Menu -->
          <div class="absolute left-0 top-full pt-1.5 hidden group-hover/dropdown:block z-50 animate-in fade-in-0 duration-100">
            <div class="w-64 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#141414] p-1.5 shadow-xl backdrop-blur-xl">
              <a
                href="/meesho-picklist-generator"
                class={`flex items-start gap-2.5 rounded-lg p-2.5 transition-colors ${
                  isPicklist
                    ? 'bg-neutral-100 dark:bg-neutral-800'
                    : 'hover:bg-neutral-50 dark:hover:bg-neutral-800/60'
                }`}
              >
                <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-900/60">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                  </svg>
                </div>
                <div>
                  <div class="text-xs font-semibold text-neutral-900 dark:text-white">Excel Picklist Generator</div>
                  <div class="text-[11px] text-neutral-500 dark:text-neutral-400">Tally SKUs & sizes before printing</div>
                </div>
              </a>

              <a
                href="/meesho-excel-to-manifest"
                class={`flex items-start gap-2.5 rounded-lg p-2.5 transition-colors ${
                  isManifest
                    ? 'bg-neutral-100 dark:bg-neutral-800'
                    : 'hover:bg-neutral-50 dark:hover:bg-neutral-800/60'
                }`}
              >
                <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-orange-50 dark:bg-orange-950/60 text-[#EA580C] border border-orange-200 dark:border-orange-900/60">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                  </svg>
                </div>
                <div>
                  <div class="text-xs font-semibold text-neutral-900 dark:text-white">CSV Dispatch Manifest</div>
                  <div class="text-[11px] text-neutral-500 dark:text-neutral-400">1-click register with intact AWBs</div>
                </div>
              </a>
            </div>
          </div>
        </div>

        <span class="h-3.5 w-px bg-neutral-200 dark:bg-neutral-800 mx-1 shrink-0"></span>

        <!-- Anchor Links -->
        <a
          href="/#multi-alert"
          class="px-2.5 py-1.5 rounded-md hover:text-[#0A0A0A] dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800/80 transition-colors whitespace-nowrap shrink-0"
        >
          Multi-Order Alert
        </a>

        <a
          href="/#printers"
          class="px-2.5 py-1.5 rounded-md hover:text-[#0A0A0A] dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800/80 transition-colors whitespace-nowrap shrink-0"
        >
          Printer Setup
        </a>

        <a
          href="/#why-free"
          class="px-2.5 py-1.5 rounded-md hover:text-[#0A0A0A] dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800/80 transition-colors whitespace-nowrap shrink-0"
        >
          Why Free
        </a>

        <a
          href="/#faq"
          class="px-2.5 py-1.5 rounded-md hover:text-[#0A0A0A] dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800/80 transition-colors whitespace-nowrap shrink-0"
        >
          FAQ
        </a>

        <a
          href="/about"
          class="px-2.5 py-1.5 rounded-md hover:text-[#0A0A0A] dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800/80 transition-colors whitespace-nowrap shrink-0"
        >
          About
        </a>
      </nav>
    </div>

    <!-- Actions (Right side) -->
    <div class="flex items-center gap-2 sm:gap-2.5 shrink-0">
      
      <!-- Dark / Light Theme Toggle Button -->
      <button
        id="theme-toggle-btn"
        type="button"
        aria-label="Toggle dark mode"
        class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 text-neutral-600 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors cursor-pointer shrink-0"
      >
        <!-- Sun Icon (visible in dark mode) -->
        <svg id="sun-icon" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon Icon (visible in light mode) -->
        <svg id="moon-icon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Try Sample Button (hidden on smaller desktop to preserve space) -->
      <button
        id="nav-sample-btn"
        class="hidden xl:inline-flex items-center justify-center rounded-md border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 px-3 py-1.5 text-xs font-medium text-[#0A0A0A] dark:text-neutral-200 shadow-2xs hover:bg-neutral-50 dark:hover:bg-neutral-800 hover:border-neutral-300 dark:hover:border-neutral-700 transition-all cursor-pointer whitespace-nowrap shrink-0"
      >
        <svg class="mr-1.5 h-3.5 w-3.5 text-[#EA580C]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        Try Sample
      </button>

      <!-- Crop Labels Free CTA Button -->
      <a
        id="nav-crop-btn"
        href="#cropper"
        class="inline-flex items-center justify-center rounded-md bg-[#0A0A0A] dark:bg-white px-3 sm:px-3.5 py-1.5 text-xs font-semibold text-white dark:text-[#0A0A0A] shadow-2xs hover:bg-neutral-800 dark:hover:bg-neutral-200 transition-all cursor-pointer whitespace-nowrap shrink-0"
      >
        Crop Labels Free
      </a>

      <!-- Mobile Menu Toggle Button (visible on screens < lg) -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        class="lg:hidden inline-flex h-8 w-8 items-center justify-center rounded-md border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 text-neutral-600 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors cursor-pointer shrink-0"
      >
        <!-- Hamburger Icon -->
        <svg id="menu-icon-open" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <!-- Close (X) Icon -->
        <svg id="menu-icon-close" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile Collapsible Navigation Menu Drawer -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-neutral-200 dark:border-neutral-800 bg-white/98 dark:bg-[#0A0A0A]/98 px-4 pt-3 pb-6 shadow-xl backdrop-blur-xl">
    <div class="space-y-4">
      
      <!-- Marketplace Tools Group -->
      <div>
        <p class="text-[11px] font-bold uppercase tracking-wider text-neutral-400 dark:text-neutral-500 mb-2">
          Marketplace Croppers & Tools
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 text-sm font-medium">
          <a
            href="/meesho-label-cropper"
            class={`flex items-center gap-2.5 px-3 py-2 rounded-lg transition-colors ${
              isMeesho
                ? 'bg-orange-50 dark:bg-orange-950/50 text-[#EA580C] font-semibold border border-orange-200 dark:border-orange-900/60'
                : 'text-neutral-700 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-800'
            }`}
          >
            <span class="flex h-2 w-2 rounded-full bg-[#EA580C]"></span>
            <span>Meesho 4×6 Cropper</span>
          </a>

          <a
            href="/flipkart-label-cropper"
            class={`flex items-center gap-2.5 px-3 py-2 rounded-lg transition-colors ${
              isFlipkart
                ? 'bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 font-semibold border border-blue-200 dark:border-blue-900/60'
                : 'text-neutral-700 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-800'
            }`}
          >
            <span class="flex h-2 w-2 rounded-full bg-blue-500"></span>
            <span>Flipkart / Shopsy Cropper</span>
          </a>

          <a
            href="/meesho-picklist-generator"
            class={`flex items-center gap-2.5 px-3 py-2 rounded-lg transition-colors ${
              isPicklist
                ? 'bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 font-semibold border border-emerald-200 dark:border-emerald-900/60'
                : 'text-neutral-700 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-800'
            }`}
          >
            <span class="flex h-2 w-2 rounded-full bg-emerald-500"></span>
            <span>Excel Picklist Generator</span>
          </a>

          <a
            href="/meesho-excel-to-manifest"
            class={`flex items-center gap-2.5 px-3 py-2 rounded-lg transition-colors ${
              isManifest
                ? 'bg-neutral-100 dark:bg-neutral-800 text-[#0A0A0A] dark:text-white font-semibold border border-neutral-300 dark:border-neutral-700'
                : 'text-neutral-700 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-800'
            }`}
          >
            <span class="flex h-2 w-2 rounded-full bg-neutral-400"></span>
            <span>Excel Dispatch Manifest</span>
          </a>
        </div>
      </div>

      <!-- Feature Anchors Group -->
      <div class="pt-2 border-t border-neutral-100 dark:border-neutral-800/80">
        <p class="text-[11px] font-bold uppercase tracking-wider text-neutral-400 dark:text-neutral-500 mb-2">
          Features & Guides
        </p>
        <div class="grid grid-cols-2 gap-1.5 text-xs text-neutral-600 dark:text-neutral-400">
          <a href="/#multi-alert" class="px-2.5 py-1.5 rounded-md hover:text-[#0A0A0A] dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
            ★ Multi-Order Alert
          </a>
          <a href="/#printers" class="px-2.5 py-1.5 rounded-md hover:text-[#0A0A0A] dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
            🖨️ Printer Setup
          </a>
          <a href="/#about-tool" class="px-2.5 py-1.5 rounded-md hover:text-[#0A0A0A] dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
            📖 Complete Guide
          </a>
          <a href="/#faq" class="px-2.5 py-1.5 rounded-md hover:text-[#0A0A0A] dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
            ❓ FAQs
          </a>
          <a href="/#privacy" class="px-2.5 py-1.5 rounded-md hover:text-[#0A0A0A] dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
            🔒 100% Client-Side
          </a>
          <a href="/#why-free" class="px-2.5 py-1.5 rounded-md hover:text-[#0A0A0A] dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
            💡 Why Free
          </a>
        </div>
      </div>

      <!-- Company & Support Links Group -->
      <div class="pt-2 border-t border-neutral-100 dark:border-neutral-800/80">
        <p class="text-[11px] font-bold uppercase tracking-wider text-neutral-400 dark:text-neutral-500 mb-2">
          Company & Help
        </p>
        <div class="grid grid-cols-2 gap-1.5 text-xs text-neutral-600 dark:text-neutral-400">
          <a href="/about" class="px-2.5 py-1.5 rounded-md hover:text-[#0A0A0A] dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
            About Us
          </a>
          <a href="/contact" class="px-2.5 py-1.5 rounded-md hover:text-[#0A0A0A] dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
            Contact Support
          </a>
          <a href="/privacy" class="px-2.5 py-1.5 rounded-md hover:text-[#0A0A0A] dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
            Privacy Policy
          </a>
          <a href="/terms" class="px-2.5 py-1.5 rounded-md hover:text-[#0A0A0A] dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
            Terms of Service
          </a>
        </div>
      </div>

      <!-- Mobile CTAs -->
      <div class="pt-3 border-t border-neutral-100 dark:border-neutral-800/80 flex flex-col gap-2">
        <button
          id="mobile-sample-btn"
          type="button"
          class="w-full inline-flex items-center justify-center gap-1.5 rounded-lg border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 py-2.5 text-xs font-semibold text-[#0A0A0A] dark:text-neutral-200 shadow-2xs hover:bg-neutral-50 dark:hover:bg-neutral-800 transition-colors cursor-pointer"
        >
          <svg class="h-3.5 w-3.5 text-[#EA580C]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          Load 15-Order Test Batch
        </button>

        <a
          href="#cropper"
          class="mobile-cropper-jump w-full inline-flex items-center justify-center rounded-lg bg-[#0A0A0A] dark:bg-white py-2.5 text-xs font-bold text-white dark:text-[#0A0A0A] shadow-xs hover:bg-neutral-800 dark:hover:bg-neutral-200 transition-colors"
        >
          Crop Labels Free
        </a>
      </div>

    </div>
  </div>
</header>

<script>
  // Theme Toggle
  const themeToggleBtn = document.getElementById('theme-toggle-btn');
  const sunIcon = document.getElementById('sun-icon');
  const moonIcon = document.getElementById('moon-icon');

  function syncThemeIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      sunIcon?.classList.remove('hidden');
      moonIcon?.classList.add('hidden');
    } else {
      sunIcon?.classList.add('hidden');
      moonIcon?.classList.remove('hidden');
    }
  }

  syncThemeIcons();

  if (themeToggleBtn) {
    themeToggleBtn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
      syncThemeIcons();
    });
  }

  // Mobile Menu Toggle
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIconOpen = document.getElementById('menu-icon-open');
  const menuIconClose = document.getElementById('menu-icon-close');

  function toggleMobileMenu() {
    if (!mobileMenu) return;
    const isHidden = mobileMenu.classList.contains('hidden');
    if (isHidden) {
      mobileMenu.classList.remove('hidden');
      menuIconOpen?.classList.add('hidden');
      menuIconClose?.classList.remove('hidden');
      mobileMenuBtn?.setAttribute('aria-expanded', 'true');
    } else {
      mobileMenu.classList.add('hidden');
      menuIconOpen?.classList.remove('hidden');
      menuIconClose?.classList.add('hidden');
      mobileMenuBtn?.setAttribute('aria-expanded', 'false');
    }
  }

  if (mobileMenuBtn) {
    mobileMenuBtn.addEventListener('click', toggleMobileMenu);
  }

  // Close mobile menu when any link is clicked
  const mobileLinks = mobileMenu?.querySelectorAll('a');
  mobileLinks?.forEach(link => {
    link.addEventListener('click', () => {
      if (!mobileMenu.classList.contains('hidden')) {
        toggleMobileMenu();
      }
    });
  });

  // Mobile sample trigger proxies to desktop sample button
  const mobileSampleBtn = document.getElementById('mobile-sample-btn');
  const navSampleBtn = document.getElementById('nav-sample-btn');
  const sampleBtn = document.getElementById('btn-sample-batch');
  if (mobileSampleBtn) {
    mobileSampleBtn.addEventListener('click', () => {
      if (!mobileMenu?.classList.contains('hidden')) {
        toggleMobileMenu();
      }
      if (sampleBtn) {
        sampleBtn.click();
      } else if (navSampleBtn) {
        navSampleBtn.click();
      }
    });
  }
</script>
