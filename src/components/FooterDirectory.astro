---
// src/components/FooterDirectory.astro
---

<footer class="bg-white dark:bg-[#0A0A0A] border-t border-border dark:border-neutral-800 pt-16 pb-12 text-xs text-[#525252] dark:text-neutral-400 transition-colors">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Directory Columns -->
    <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-8 mb-12">
      
      <!-- Brand & Status Pill -->
      <div class="col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-2">
          <div class="flex h-6 w-6 items-center justify-center rounded-[4px] bg-[#0A0A0A] dark:bg-white text-white dark:text-[#0A0A0A]">
            <div class="h-2 w-2 rounded-[1.5px] bg-[#EA580C]"></div>
          </div>
          <span class="text-sm font-bold tracking-tight text-[#0A0A0A] dark:text-white">
            SmartLabelCrop<span class="text-[#EA580C]">.in</span>
          </span>
        </a>

        <p class="text-xs text-[#737373] dark:text-neutral-400 max-w-sm leading-relaxed">
          The high-speed WebAssembly label cropper, SKU rescuer, and multi-quantity packing protector for Indian e-commerce merchants on Meesho, Flipkart, and Shopsy.
        </p>

        <!-- System Status Pill -->
        <div class="inline-flex items-center gap-2 rounded-full border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-[#141414] px-3 py-1 text-[11px] font-medium text-neutral-700 dark:text-neutral-300">
          <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>WASM Engine Active &bull; 100% Client-Side</span>
        </div>
      </div>

      <!-- Column 1: Marketplaces & Dedicated Tools -->
      <div>
        <h4 class="font-semibold text-[#0A0A0A] dark:text-white mb-3">Marketplace Tools</h4>
        <ul class="space-y-2">
          <li><a href="/meesho-label-cropper" class="hover:text-black dark:hover:text-white transition-colors">Meesho Label Cropper</a></li>
          <li><a href="/flipkart-label-cropper" class="hover:text-black dark:hover:text-white transition-colors">Flipkart 4×6 Cropper</a></li>
          <li><a href="/flipkart-label-cropper" class="hover:text-black dark:hover:text-white transition-colors">Shopsy Wholesale Label</a></li>
          <li><a href="/meesho-picklist-generator" class="hover:text-black dark:hover:text-white transition-colors font-medium text-emerald-600 dark:text-emerald-400">Order Picklist Generator</a></li>
          <li><a href="/meesho-excel-to-manifest" class="hover:text-black dark:hover:text-white transition-colors font-medium text-emerald-600 dark:text-emerald-400">Excel Manifest Exporter</a></li>
        </ul>
      </div>

      <!-- Column 2: Couriers Supported -->
      <div>
        <h4 class="font-semibold text-[#0A0A0A] dark:text-white mb-3">Couriers Handover</h4>
        <ul class="space-y-2">
          <li><span class="text-neutral-600 dark:text-neutral-400">Valmo Express (Meesho)</span></li>
          <li><span class="text-neutral-600 dark:text-neutral-400">Ekart Logistics (Flipkart)</span></li>
          <li><span class="text-neutral-600 dark:text-neutral-400">Delhivery Surface</span></li>
          <li><span class="text-neutral-600 dark:text-neutral-400">Shadowfax E-Com</span></li>
          <li><span class="text-neutral-600 dark:text-neutral-400">Xpressbees Express</span></li>
        </ul>
      </div>

      <!-- Column 3: Seller Guides & Resources -->
      <div>
        <h4 class="font-semibold text-[#0A0A0A] dark:text-white mb-3">Seller Guides</h4>
        <ul class="space-y-2">
          <li><a href="/#printers" class="hover:text-black dark:hover:text-white transition-colors">Thermal Printer Calibration</a></li>
          <li><a href="/#multi-alert" class="hover:text-black dark:hover:text-white transition-colors">Multi-Order Pack SOP</a></li>
          <li><a href="/#about-tool" class="hover:text-black dark:hover:text-white transition-colors">Complete Label Guide</a></li>
          <li><a href="/#faq" class="hover:text-black dark:hover:text-white transition-colors">FAQs & Knowledge Base</a></li>
          <li><a href="/#privacy" class="hover:text-black dark:hover:text-white transition-colors">100% Offline PWA Mode</a></li>
        </ul>
      </div>

      <!-- Column 4: Company & Legal -->
      <div>
        <h4 class="font-semibold text-[#0A0A0A] dark:text-white mb-3">Company & Legal</h4>
        <ul class="space-y-2">
          <li><a href="/about" class="hover:text-black dark:hover:text-white transition-colors">About Us</a></li>
          <li><a href="/contact" class="hover:text-black dark:hover:text-white transition-colors">Contact Us</a></li>
          <li><a href="/privacy" class="hover:text-black dark:hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-black dark:hover:text-white transition-colors">Terms & Conditions</a></li>
          <li><a href="/sitemap.xml" target="_blank" class="hover:text-black dark:hover:text-white transition-colors font-mono text-[11px]">Sitemap (XML)</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Legal & Certification Row -->
    <div class="border-t border-neutral-200/80 dark:border-neutral-800/80 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-[#737373] dark:text-neutral-500">
      <div>
        &copy; {new Date().getFullYear()} SmartLabelCrop.in. Built with high-performance WebAssembly for Indian merchants.
      </div>
      
      <div class="flex flex-wrap items-center justify-center gap-3">
        <span>DPDP Act 2023 Compliant</span>
        <span>&bull;</span>
        <span>Zero Remote PDF Retention</span>
        <span>&bull;</span>
        <a href="/privacy" class="hover:underline">Privacy</a>
        <span>&bull;</span>
        <a href="/terms" class="hover:underline">Terms</a>
        <span>&bull;</span>
        <span>Made with ❤️ in India</span>
      </div>
    </div>

  </div>
</footer>
