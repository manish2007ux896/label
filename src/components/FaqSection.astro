---
// src/components/FaqSection.astro
import { defaultFaqs } from '../layouts/Layout.astro';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  faqs?: FaqItem[];
  title?: string;
  subtitle?: string;
}

const {
  faqs = defaultFaqs,
  title = "Frequently Asked Questions",
  subtitle = "Everything Indian e-commerce merchants need to know about cropping Meesho & Flipkart shipping labels for 4×6 thermal printers."
} = Astro.props;
---

<section id="faq" class="py-16 sm:py-24 bg-neutral-50/70 dark:bg-[#0d0d0d] border-b border-border dark:border-neutral-800 transition-colors scroll-mt-20">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 mb-3">
        <span class="h-2 w-2 rounded-[2px] bg-[#EA580C]"></span>
        <span class="text-xs font-semibold uppercase tracking-wider text-[#525252] dark:text-neutral-400">
          Knowledge Base & Help
        </span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#0A0A0A] dark:text-white font-display">
        {title}
      </h2>
      <p class="mt-3 text-sm sm:text-base text-[#525252] dark:text-neutral-400 font-body max-w-2xl mx-auto leading-relaxed">
        {subtitle}
      </p>
    </div>

    <!-- Accordion Container -->
    <div class="space-y-3">
      {faqs.map((faq, index) => (
        <details
          class="group rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#141414] shadow-2xs transition-all duration-200 open:border-orange-300 dark:open:border-orange-900/60 open:shadow-sm"
          {...(index === 0 ? { open: true } : {})}
        >
          <summary class="flex items-center justify-between gap-4 p-4 sm:p-5 cursor-pointer list-none select-none font-medium text-sm sm:text-base text-[#0A0A0A] dark:text-white hover:text-[#EA580C] dark:hover:text-[#EA580C] transition-colors">
            <span class="font-semibold text-left leading-snug">
              {faq.question}
            </span>
            <span class="shrink-0 flex h-6 w-6 items-center justify-center rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-500 group-open:bg-orange-100 dark:group-open:bg-orange-950/60 group-open:text-[#EA580C] transition-transform duration-200 group-open:rotate-180">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="px-4 pb-5 sm:px-5 pt-1 text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 font-body leading-relaxed border-t border-neutral-100 dark:border-neutral-800/80 mt-1">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <!-- Contact & Direct Help Box -->
    <div class="mt-10 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#111111] p-6 text-center shadow-xs">
      <h3 class="text-sm font-semibold text-[#0A0A0A] dark:text-white">
        Have a specific question about your printer model or order file format?
      </h3>
      <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">
        We help sellers across Surat, Jaipur, Tirupur, and Delhi NCR calibrate their setups every day.
      </p>
      <div class="mt-4 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/contact"
          class="inline-flex items-center justify-center rounded-md bg-[#0A0A0A] dark:bg-white px-4 py-2 text-xs font-semibold text-white dark:text-[#0A0A0A] hover:bg-neutral-800 dark:hover:bg-neutral-200 transition-colors shadow-2xs"
        >
          Contact Support Team
        </a>
        <a
          href="/#printers"
          class="inline-flex items-center justify-center rounded-md border border-neutral-300 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-900 px-4 py-2 text-xs font-medium text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
        >
          View Thermal Printer Guide
        </a>
      </div>
    </div>

  </div>
</section>
