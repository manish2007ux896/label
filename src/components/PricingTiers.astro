---
// src/components/PricingTiers.astro
---

<section id="pricing" class="py-16 sm:py-20 bg-white dark:bg-[#0A0A0A] border-b border-border dark:border-neutral-800 transition-colors">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 mb-2">
        <span class="h-2 w-2 rounded-[2px] bg-[#EA580C]"></span>
        <span class="text-xs font-semibold uppercase tracking-wider text-[#525252] dark:text-neutral-400">Predictable Pricing</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#0A0A0A] dark:text-white font-display">
        Simple, Fair Pricing for Indian Sellers
      </h2>
      <p class="mt-3 text-sm sm:text-base text-[#525252] dark:text-neutral-400 font-body">
        Start 100% free with unlimited cropping during our 60-day launch beta. Upgrade anytime via UPI QR with instant 12-digit UTR activation.
      </p>
    </div>

    <!-- Pricing Grid in dub.co style -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 max-w-6xl mx-auto">
      
      <!-- Card 1: Free Beta Tier -->
      <div class="flex flex-col rounded-2xl border border-border dark:border-neutral-800 bg-[#FAFAFA] dark:bg-[#111111] p-6 lg:p-8">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-[#525252] dark:text-neutral-400">Free Launch Beta</span>
          <div class="mt-4 flex items-baseline gap-1">
            <span class="text-4xl font-extrabold text-[#0A0A0A] dark:text-white font-display">₹0</span>
            <span class="text-xs text-[#525252] dark:text-neutral-400 font-medium">/ 60 days</span>
          </div>
          <p class="mt-3 text-xs text-[#525252] dark:text-neutral-400 leading-relaxed">
            Essential for every Meesho, Flipkart, and Shopsy supplier looking to eliminate dispatch errors.
          </p>
        </div>

        <div class="mt-6 flex-1 border-t border-neutral-200/80 dark:border-neutral-800 pt-6">
          <ul class="space-y-3 text-xs text-neutral-700 dark:text-neutral-300">
            <li class="flex items-center gap-2.5">
              <span class="h-1.5 w-1.5 rounded-full bg-[#EA580C]"></span>
              <span>Unlimited PDF Label Cropping</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="h-1.5 w-1.5 rounded-full bg-[#EA580C]"></span>
              <span>Rescued SKU, Size & Color Stamp</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="h-1.5 w-1.5 rounded-full bg-[#EA580C]"></span>
              <span>Inverted Black [★ MULTI-ORDER ★] Box</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="h-1.5 w-1.5 rounded-full bg-[#EA580C]"></span>
              <span>Courier Grouping (Valmo/Delhivery/Ekart)</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="h-1.5 w-1.5 rounded-full bg-[#EA580C]"></span>
              <span>30-Day Duplicate AWB Blocker</span>
            </li>
          </ul>
        </div>

        <div class="mt-8 pt-4">
          <a
            href="#cropper"
            class="block w-full rounded-md border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-[#1A1A1A] py-2.5 text-center text-xs font-bold text-[#0A0A0A] dark:text-white hover:bg-neutral-50 dark:hover:bg-neutral-800 hover:border-black dark:hover:border-neutral-500 transition-colors shadow-2xs"
          >
            Start Cropping Free
          </a>
        </div>
      </div>

      <!-- Card 2: Pro Seller Pass (Featured) -->
      <div class="relative flex flex-col rounded-2xl border-2 border-black dark:border-orange-500 bg-white dark:bg-[#141414] p-6 lg:p-8 shadow-lg">
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 rounded-full bg-[#0A0A0A] dark:bg-orange-500 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-white shadow-xs">
          ★ Most Popular with Surat Sellers
        </div>

        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-[#EA580C] dark:text-orange-400">Pro Seller Pass</span>
          <div class="mt-4 flex items-baseline gap-1">
            <span class="text-4xl font-extrabold text-[#0A0A0A] dark:text-white font-display">₹79</span>
            <span class="text-xs text-[#525252] dark:text-neutral-400 font-medium">/ month (or ₹199 / 3-mo)</span>
          </div>
          <p class="mt-3 text-xs text-[#525252] dark:text-neutral-400 leading-relaxed">
            For growing fashion, home & electronics sellers packing 50+ orders daily.
          </p>
        </div>

        <div class="mt-6 flex-1 border-t border-neutral-200/80 dark:border-neutral-800 pt-6">
          <ul class="space-y-3 text-xs text-neutral-700 dark:text-neutral-300">
            <li class="flex items-center gap-2.5 font-semibold text-[#0A0A0A] dark:text-white">
              <span class="h-1.5 w-1.5 rounded-full bg-[#EA580C]"></span>
              <span>Everything in Free Beta, plus:</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="h-1.5 w-1.5 rounded-full bg-[#EA580C]"></span>
              <span>Page-1 Thermal Picklist Sticker Generator</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="h-1.5 w-1.5 rounded-full bg-[#EA580C]"></span>
              <span>Custom Unboxing Safety Watermark</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="h-1.5 w-1.5 rounded-full bg-[#EA580C]"></span>
              <span>Apparel Size Smart Sorter (XS → 3XL)</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="h-1.5 w-1.5 rounded-full bg-[#EA580C]"></span>
              <span>Priority WhatsApp Calibration Support</span>
            </li>
          </ul>
        </div>

        <div class="mt-8 pt-4">
          <button
            id="btn-upi-pro"
            class="block w-full rounded-md bg-[#0A0A0A] dark:bg-white py-2.5 text-center text-xs font-bold text-white dark:text-[#0A0A0A] hover:bg-neutral-800 dark:hover:bg-neutral-200 transition-colors shadow-sm cursor-pointer"
          >
            Upgrade via UPI QR (₹79)
          </button>
        </div>
      </div>

      <!-- Card 3: Warehouse & Hub Pass -->
      <div class="flex flex-col rounded-2xl border border-border dark:border-neutral-800 bg-[#FAFAFA] dark:bg-[#111111] p-6 lg:p-8">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-[#525252] dark:text-neutral-400">Warehouse & Hubs</span>
          <div class="mt-4 flex items-baseline gap-1">
            <span class="text-4xl font-extrabold text-[#0A0A0A] dark:text-white font-display">₹499</span>
            <span class="text-xs text-[#525252] dark:text-neutral-400 font-medium">/ 6-month pass</span>
          </div>
          <p class="mt-3 text-xs text-[#525252] dark:text-neutral-400 leading-relaxed">
            Multi-user license for manufacturing plants, textile mills, and 3PL fulfillment hubs.
          </p>
        </div>

        <div class="mt-6 flex-1 border-t border-neutral-200/80 dark:border-neutral-800 pt-6">
          <ul class="space-y-3 text-xs text-neutral-700 dark:text-neutral-300">
            <li class="flex items-center gap-2.5">
              <span class="h-1.5 w-1.5 rounded-full bg-[#EA580C]"></span>
              <span>Multiple Packing Station Terminals</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="h-1.5 w-1.5 rounded-full bg-[#EA580C]"></span>
              <span>Rack & Bin Inventory Slot Mapping</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="h-1.5 w-1.5 rounded-full bg-[#EA580C]"></span>
              <span>Consolidated 6 PM Carrier Manifest Export</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="h-1.5 w-1.5 rounded-full bg-[#EA580C]"></span>
              <span>Dedicated Account Manager & Phone Setup</span>
            </li>
          </ul>
        </div>

        <div class="mt-8 pt-4">
          <a
            href="https://wa.me/919999999999?text=Interested%20in%20SmartLabelCrop%20Warehouse%20Pass"
            target="_blank"
            class="block w-full rounded-md border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-[#1A1A1A] py-2.5 text-center text-xs font-bold text-[#0A0A0A] dark:text-white hover:bg-neutral-50 dark:hover:bg-neutral-800 hover:border-black dark:hover:border-neutral-500 transition-colors shadow-2xs"
          >
            Contact Hub Sales
          </a>
        </div>
      </div>

    </div>

    <!-- UPI Modal -->
    <div id="upi-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 dark:bg-black/80 backdrop-blur-xs p-4">
      <div class="w-full max-w-md rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#141414] p-6 shadow-2xl">
        <div class="flex items-center justify-between border-b border-neutral-200 dark:border-neutral-800 pb-3">
          <div class="flex items-center gap-2">
            <div class="h-3 w-3 rounded-xs bg-[#EA580C]"></div>
            <h3 class="text-sm font-bold text-[#0A0A0A] dark:text-white">Instant UPI Pro Activation</h3>
          </div>
          <button id="close-upi-modal" class="text-neutral-400 hover:text-black dark:hover:text-white cursor-pointer text-base font-bold">&times;</button>
        </div>

        <div class="mt-4 text-center">
          <p class="text-xs text-neutral-600 dark:text-neutral-400 mb-3">
            Scan with Google Pay, PhonePe, Paytm, or BHIM to activate Pro Pass (₹79/mo)
          </p>

          <!-- Simulated Dynamic UPI QR SVG -->
          <div class="mx-auto flex h-48 w-48 items-center justify-center rounded-xl border border-neutral-300 dark:border-neutral-700 bg-white p-2">
            <svg class="h-40 w-40 text-[#0A0A0A]" viewBox="0 0 100 100" fill="currentColor">
              <!-- Corner squares -->
              <rect x="5" y="5" width="25" height="25" rx="2" fill="none" stroke="currentColor" stroke-width="4"/>
              <rect x="12" y="12" width="11" height="11" fill="currentColor"/>
              
              <rect x="70" y="5" width="25" height="25" rx="2" fill="none" stroke="currentColor" stroke-width="4"/>
              <rect x="77" y="12" width="11" height="11" fill="currentColor"/>
              
              <rect x="5" y="70" width="25" height="25" rx="2" fill="none" stroke="currentColor" stroke-width="4"/>
              <rect x="12" y="77" width="11" height="11" fill="currentColor"/>

              <!-- Center dots -->
              <rect x="36" y="12" width="6" height="6"/>
              <rect x="48" y="12" width="12" height="6"/>
              <rect x="36" y="24" width="18" height="6"/>
              <rect x="12" y="36" width="6" height="18"/>
              <rect x="24" y="36" width="12" height="6"/>
              <rect x="24" y="48" width="6" height="12"/>

              <rect x="42" y="42" width="16" height="16" fill="#EA580C"/>
              
              <rect x="66" y="36" width="12" height="6"/>
              <rect x="84" y="36" width="6" height="18"/>
              <rect x="66" y="48" width="6" height="12"/>
              <rect x="78" y="48" width="12" height="6"/>

              <rect x="36" y="66" width="18" height="6"/>
              <rect x="42" y="78" width="12" height="12"/>
              <rect x="66" y="66" width="6" height="18"/>
              <rect x="78" y="72" width="12" height="6"/>
              <rect x="78" y="84" width="12" height="6"/>
            </svg>
          </div>

          <div class="mt-3 font-mono text-xs font-bold text-[#0A0A0A] dark:text-white">
            UPI ID: <span class="select-all text-[#EA580C]">smartlabelcrop@upi</span>
          </div>

          <!-- 12-Digit UTR Input Form for Fallback Manual Validation -->
          <div class="mt-4 text-left border-t border-neutral-100 dark:border-neutral-800 pt-3">
            <label class="block text-[11px] font-semibold text-neutral-700 dark:text-neutral-300 mb-1">
              Enter 12-digit UPI UTR / Ref Number after payment:
            </label>
            <div class="flex gap-2">
              <input
                type="text"
                id="input-utr"
                maxlength="12"
                placeholder="e.g. 412389102931"
                class="flex-1 rounded-md border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-[#1A1A1A] px-2.5 py-1.5 text-xs font-mono text-[#0A0A0A] dark:text-white focus:border-black focus:outline-hidden"
              />
              <button
                id="btn-verify-utr"
                class="rounded-md bg-[#0A0A0A] dark:bg-white px-3 py-1.5 text-xs font-semibold text-white dark:text-[#0A0A0A] hover:bg-neutral-800 dark:hover:bg-neutral-200 transition-colors cursor-pointer"
              >
                Verify & Activate
              </button>
            </div>
            <p id="utr-status-msg" class="hidden mt-2 text-[11px] text-emerald-600 dark:text-emerald-400 font-medium"></p>
          </div>

        </div>
      </div>
    </div>

  </div>
</section>

<script>
  const upiModal = document.getElementById('upi-modal') as HTMLElement | null;
  const btnUpiPro = document.getElementById('btn-upi-pro') as HTMLElement | null;
  const closeUpiModal = document.getElementById('close-upi-modal') as HTMLElement | null;
  const btnVerifyUtr = document.getElementById('btn-verify-utr') as HTMLButtonElement | null;
  const inputUtr = document.getElementById('input-utr') as HTMLInputElement | null;
  const utrStatusMsg = document.getElementById('utr-status-msg') as HTMLElement | null;

  if (btnUpiPro && upiModal) {
    btnUpiPro.addEventListener('click', () => {
      upiModal.classList.remove('hidden');
    });
  }

  if (closeUpiModal && upiModal) {
    closeUpiModal.addEventListener('click', () => {
      upiModal.classList.add('hidden');
    });
  }

  if (btnVerifyUtr && inputUtr && utrStatusMsg) {
    btnVerifyUtr.addEventListener('click', () => {
      const val = inputUtr.value.trim();
      if (val.length === 12 && /^\d+$/.test(val)) {
        utrStatusMsg.textContent = `✓ Pro Pass activated for UTR ${val}! Unlimited access enabled.`;
        utrStatusMsg.classList.remove('hidden', 'text-red-600');
        utrStatusMsg.classList.add('text-emerald-600');
        setTimeout(() => {
          if (upiModal) upiModal.classList.add('hidden');
        }, 2000);
      } else {
        utrStatusMsg.textContent = 'Please enter a valid 12-digit numeric UPI reference number.';
        utrStatusMsg.classList.remove('hidden', 'text-emerald-600');
        utrStatusMsg.classList.add('text-red-600');
      }
    });
  }
</script>
