  faqItems={defaultFaqs}
>
  <Navbar />
  <main class="flex-1">
    <HeroStage />
    <CropperWorkspace />
    <MultiOrderAlertSection />
    <PrinterSetupGuide />
    <PrivacyGuaranteeSection />
    <WhyFreeAndComparison />
    <SeoContentSection />
    <FaqSection />
  </main>
  <FooterDirectory />
