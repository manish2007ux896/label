---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HeroStage from '../components/HeroStage.astro';
import CropperWorkspace from '../components/CropperWorkspace.astro';
import MultiOrderAlertSection from '../components/MultiOrderAlertSection.astro';
import PrinterSetupGuide from '../components/PrinterSetupGuide.astro';
import PrivacyGuaranteeSection from '../components/PrivacyGuaranteeSection.astro';
import WhyFreeAndComparison from '../components/WhyFreeAndComparison.astro';
import FooterDirectory from '../components/FooterDirectory.astro';
---

<Layout
  title="SmartLabelCrop.in | Free Meesho & Flipkart 4x6 Thermal Label Cropper & Multi-Order Rescuer"
  description="100% private in-browser WebAssembly label cropper for Meesho and Flipkart sellers. Rescues hidden SKUs, stamps inverted black multi-pack alerts, and groups orders by courier."
>
  <Navbar />
  <main class="flex-1">
    <HeroStage />
    <CropperWorkspace />
    <MultiOrderAlertSection />
    <PrinterSetupGuide />
    <PrivacyGuaranteeSection />
    <WhyFreeAndComparison />
  </main>
  <FooterDirectory />
</Layout>
