---
// src/pages/index.astro
import Layout, { defaultFaqs } from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HeroStage from '../components/HeroStage.astro';
import CropperWorkspace from '../components/CropperWorkspace.astro';
import MultiOrderAlertSection from '../components/MultiOrderAlertSection.astro';
import PrinterSetupGuide from '../components/PrinterSetupGuide.astro';
import PrivacyGuaranteeSection from '../components/PrivacyGuaranteeSection.astro';
import WhyFreeAndComparison from '../components/WhyFreeAndComparison.astro';
import SeoContentSection from '../components/SeoContentSection.astro';
import FaqSection from '../components/FaqSection.astro';
import FooterDirectory from '../components/FooterDirectory.astro';
---

<Layout
