---
// src/pages/terms.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import FooterDirectory from '../components/FooterDirectory.astro';

const termsFaqs = [
  {
    question: "Is SmartLabelCrop affiliated with Meesho or Flipkart?",
    answer: "No. SmartLabelCrop.in is an independent, non-affiliated productivity utility developed to assist e-commerce sellers with PDF cropping and warehouse efficiency. All marketplace trademarks and brand names belong to their respective owners."
  },
  {
    question: "Are there any hidden charges or fees for high batch volumes?",
    answer: "No. The service is completely free of charge regardless of whether you process 5 labels or 5,000 labels per day."
  }
];
---

<Layout
  title="Terms & Conditions | SmartLabelCrop.in"
  description="Read the terms of service and usage conditions for SmartLabelCrop.in. Free client-side thermal shipping label cropping tool for Indian sellers."
  canonicalUrl="https://smartlabelcrop.in/terms"
  keywords="smartlabelcrop terms and conditions, terms of service meesho label cropper, free software disclaimer"
  faqItems={termsFaqs}
>
  <Navbar />

  <main class="flex-1 bg-white dark:bg-[#0A0A0A] text-neutral-800 dark:text-neutral-200 transition-colors">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12 sm:py-20">
      
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400 mb-6 font-mono">
        <a href="/" class="hover:text-black dark:hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-[#EA580C] font-semibold">Terms & Conditions</span>
      </nav>

      <!-- Page Header -->
      <header class="mb-12 border-b border-neutral-200 dark:border-neutral-800 pb-8">
        <div class="inline-flex items-center gap-2 rounded-full border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 px-3 py-1 text-xs font-semibold text-neutral-700 dark:text-neutral-300 mb-4">
          Fair Use & Transparent Service Agreement
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-[#0A0A0A] dark:text-white font-display">
          Terms & Conditions
        </h1>
        <p class="mt-3 text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 font-mono">
          Last Updated: November 2026 &bull; Effective for all users
        </p>
      </header>

      <!-- Terms Body -->
      <div class="prose prose-neutral dark:prose-invert max-w-none space-y-8 text-sm sm:text-base leading-relaxed">
        
        <section class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-bold text-[#0A0A0A] dark:text-white font-display">
            1. Acceptance of Terms
          </h2>
          <p>
            By accessing or using <strong>SmartLabelCrop.in</strong> (the "Service"), you agree to be bound by these Terms and Conditions. If you do not agree to these terms, please do not use the tool. These terms apply to all visitors, sellers, and warehouse operators who access or utilize the Service.
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-bold text-[#0A0A0A] dark:text-white font-display">
            2. Description of Service & Free Access
          </h2>
          <p>
            SmartLabelCrop.in provides a browser-based, client-side WebAssembly utility to resize, crop, sort, and optimize e-commerce shipping label PDFs into 4×6 inch thermal formats. The Service is provided free of charge without mandatory subscriptions, sign-ups, or usage quotas. We reserve the right to modify or discontinue features at any time without prior notice.
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-bold text-[#0A0A0A] dark:text-white font-display">
            3. Trademark & Non-Affiliation Disclaimer
          </h2>
          <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 bg-[#FAFAFA] dark:bg-[#141414] p-5 not-prose">
            <h3 class="text-xs font-bold uppercase tracking-wider text-[#EA580C] mb-1">Notice of Independent Software</h3>
            <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed font-body">
              <strong>SmartLabelCrop.in</strong> is an independent software tool. It is <strong>NOT</strong> affiliated with, associated with, authorized by, endorsed by, or in any way officially connected with Meesho, Fashnear Technologies Pvt. Ltd., Flipkart Internet Pvt. Ltd., Walmart, Amazon.com Inc., Valmo Express, Ekart Logistics, Delhivery Ltd., Shadowfax, or any of their subsidiaries or affiliates. The names Meesho, Flipkart, Shopsy, Valmo, Ekart, Delhivery, as well as related names, marks, emblems, and images are registered trademarks of their respective owners.
            </p>
          </div>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-bold text-[#0A0A0A] dark:text-white font-display">
            4. User Responsibilities & Label Verification
          </h2>
          <p>
            While SmartLabelCrop is designed with high accuracy and native vector barcode preservation, users are solely responsible for:
          </p>
          <ul class="list-disc pl-5 space-y-1 text-neutral-600 dark:text-neutral-400">
            <li>Verifying that printed shipping labels comply with their marketplace's packaging guidelines and courier partner requirements.</li>
            <li>Conducting routine test scans of printed barcodes with a handheld barcode scanner before handing packages over to logistics partners.</li>
            <li>Ensuring proper thermal printer darkness and calibration settings to avoid faded prints.</li>
          </ul>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-bold text-[#0A0A0A] dark:text-white font-display">
            5. Disclaimer of Warranties & Limitation of Liability
          </h2>
          <p>
            THE SERVICE IS PROVIDED ON AN "AS IS" AND "AS AVAILABLE" BASIS WITHOUT ANY WARRANTIES OF ANY KIND, EXPRESS OR IMPLIED. TO THE MAXIMUM EXTENT PERMITTED BY APPLICABLE INDIAN LAW, SMARTLABELCROP.IN AND ITS DEVELOPERS SHALL NOT BE LIABLE FOR ANY INDIRECT, INCIDENTAL, SPECIAL, OR CONSEQUENTIAL DAMAGES, INCLUDING LOSS OF PROFITS, DISPATCH DELAYS, MARKETPLACE QUALITY DEDUCTIONS, OR COURIER RTO CHARGES ARISING OUT OF OR IN CONNECTION WITH THE USE OF THIS SERVICE.
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl sm:text-2xl font-bold text-[#0A0A0A] dark:text-white font-display">
            6. Governing Law & Jurisdiction
          </h2>
          <p>
            These Terms shall be governed and construed in accordance with the laws of India, including the Information Technology Act 2000. Any legal dispute arising under these terms shall be subject to the exclusive jurisdiction of the competent courts in India.
          </p>
        </section>

      </div>

      <!-- Footer navigation -->
      <div class="mt-12 pt-8 border-t border-neutral-200 dark:border-neutral-800 flex items-center justify-between">
        <a href="/" class="text-xs font-semibold text-[#EA580C] hover:underline flex items-center gap-1.5">
          &larr; Back to Tool
        </a>
        <a href="/privacy" class="text-xs text-neutral-500 hover:text-black dark:hover:text-white transition-colors">
          Read Privacy Policy &rarr;
        </a>
      </div>

    </div>
  </main>

  <FooterDirectory />
</Layout>
