---
// src/pages/meesho-picklist-generator.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import CropperWorkspace from '../components/CropperWorkspace.astro';
import PrinterSetupGuide from '../components/PrinterSetupGuide.astro';
import WhyFreeAndComparison from '../components/WhyFreeAndComparison.astro';
import FooterDirectory from '../components/FooterDirectory.astro';

const picklistFaqs = [
  {
    question: "What is a Meesho warehouse picklist?",
    answer: "A picklist is a consolidated packing document that aggregates items by SKU, apparel size, and color across all orders in your daily batch. Instead of pickers walking back and forth to warehouse shelves for every individual order, they pull total required units in one single run."
  },
  {
    question: "How do I create a picklist before printing shipping labels?",
    answer: "Download your 'Pending Orders' or 'Ready to Ship' CSV/Excel report from the Meesho Supplier Panel. Click 'Excel Order Picklist' above or drop your report file. Our tool aggregates total units by SKU and rack location, generating a 4x6 thermal sticker or A4 picking sheet in seconds."
  },
  {
    question: "Can I map internal warehouse rack and shelf coordinates?",
    answer: "Yes! Upload an optional SKU ↔ Rack mapping file (or download our sample template). The picklist will automatically group and sort items by your physical warehouse aisle or shelf (e.g., RACK-A1, BIN-14)."
  },
  {
    question: "Does SmartLabelCrop include the picklist in PDF label batches?",
    answer: "Yes. When you drop your Meesho shipping label PDF, checking 'Page-1 Courier Picklist Sticker' automatically prepends Sticker #1 containing total units to pull and carrier handover breakdown before label #1 prints."
  }
];
---

<Layout
  title="Meesho Picklist Generator Free Online | 4x6 Thermal & A4 Picking Sheets"
  description="Generate consolidated warehouse picklists for Meesho and Flipkart orders from PDFs or Excel reports. Tally SKUs, sizes, colors, and rack coordinates in seconds."
  canonicalUrl="https://smartlabelcrop.in/meesho-picklist-generator"
  keywords="meesho picklist generator, meesho order picklist, meesho warehouse picking sheet, meesho excel to picklist, thermal picklist sticker, ecommerce warehouse picking tool"
  faqItems={picklistFaqs}
>
  <Navbar />
  
  <main class="flex-1">
    <!-- Tailored Picklist Hero Header -->
    <section class="pt-12 pb-6 bg-gradient-to-b from-emerald-50/50 via-white to-white dark:from-emerald-950/20 dark:via-[#0A0A0A] dark:to-[#0A0A0A] border-b border-neutral-200 dark:border-neutral-800">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-emerald-200 dark:border-emerald-900/60 bg-emerald-50 dark:bg-emerald-950/30 px-3 py-1 text-xs font-semibold text-emerald-700 dark:text-emerald-300 mb-4">
          📋 WAREHOUSE DISPATCH AUTOMATION
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-[#0A0A0A] dark:text-white font-display">
          Free Meesho & Flipkart Picklist Generator
        </h1>
        <p class="mt-3 text-sm sm:text-base text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto">
          Tally daily SKU quantities, sizes, and colors in seconds. Pull stock from warehouse racks before printing labels, saving 2+ hours of packing floor chaos every evening.
        </p>
      </div>
    </section>

    <!-- Interactive Cropper Workspace Component -->
    <CropperWorkspace />

    <!-- Why Picklist Saves 2+ Hours Section -->
    <section class="py-16 bg-[#FAFAFA] dark:bg-[#111111] border-b border-neutral-200 dark:border-neutral-800">
      <div class="mx-auto max-w-5xl px-4 sm:px-6">
        <h2 class="text-2xl sm:text-3xl font-bold text-center text-[#0A0A0A] dark:text-white font-display mb-10">
          Order-by-Order vs. Aggregated Warehouse Picking
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="rounded-2xl border border-red-200 dark:border-red-900/40 bg-red-50/30 dark:bg-red-950/10 p-6">
            <div class="flex items-center gap-2 text-red-600 font-bold text-sm mb-3">
              <span>✗ The Painful Old Way (Packing Without Picklist)</span>
            </div>
            <ul class="space-y-3 text-xs text-neutral-600 dark:text-neutral-400">
              <li>• Workers take 1 label, walk to shelf 14, pick 1 kurti, and return to table.</li>
              <li>• They take label 2, find out it needs the same kurti, and walk back to shelf 14 again.</li>
              <li>• 500 orders require walking 8+ kilometers across the warehouse floor.</li>
              <li>• Constant mismatch between physical stock and packed parcels.</li>
            </ul>
          </div>

          <div class="rounded-2xl border border-emerald-200 dark:border-emerald-900/40 bg-emerald-50/30 dark:bg-emerald-950/10 p-6">
            <div class="flex items-center gap-2 text-emerald-600 font-bold text-sm mb-3">
              <span>✓ The SmartLabelCrop Picklist Way</span>
            </div>
            <ul class="space-y-3 text-xs text-neutral-600 dark:text-neutral-400">
              <li>• 1 single sheet tells pickers: "Pull exactly 45 units of SAREE_RED from Rack A1".</li>
              <li>• Entire batch inventory is collected in 1 single pass with plastic totes.</li>
              <li>• Packers sit at tables and pack continuously without ever leaving their workstation.</li>
              <li>• Dispatches complete 2 hours earlier, beating the 6 PM courier pickup deadline.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <PrinterSetupGuide />
    <WhyFreeAndComparison />
  </main>

  <FooterDirectory />
</Layout>
