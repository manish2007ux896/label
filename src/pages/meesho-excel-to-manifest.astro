---
// src/pages/meesho-excel-to-manifest.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import CropperWorkspace from '../components/CropperWorkspace.astro';
import PrinterSetupGuide from '../components/PrinterSetupGuide.astro';
import WhyFreeAndComparison from '../components/WhyFreeAndComparison.astro';
import FooterDirectory from '../components/FooterDirectory.astro';

const manifestFaqs = [
  {
    question: "What is an e-commerce dispatch handover manifest?",
    answer: "A handover manifest is an official ledger documenting every single parcel, AWB number, courier partner (Valmo, Ekart, Delhivery), and quantity handed over to the pickup executive at 6 PM. It serves as your primary legal defense against false 'Not Handed Over' carrier penalties."
  },
  {
    question: "How do I export my Meesho shipping batch to an Excel spreadsheet?",
    answer: "After dropping your PDF shipping labels into SmartLabelCrop.in, click 'Export Manifest (CSV)' in the sticky action bar. In under 1 second, our client-side engine generates a clean Excel-compatible CSV file containing Order IDs, AWBs, couriers, SKUs, and exact timestamps."
  },
  {
    question: "Why do AWB numbers in other CSV exports turn into scientific notation?",
    answer: "Microsoft Excel on Windows automatically abbreviates numbers longer than 11 digits into scientific notation (e.g., 1.48291E+11) and drops trailing digits. SmartLabelCrop formats AWBs using Excel text formula escaping (`=\"AWB\"`), ensuring 100% of digits remain intact."
  },
  {
    question: "Does the CSV file include multi-quantity order warnings?",
    answer: "Yes! Every row in the exported manifest includes a dedicated 'Multi-Order Risk' column, clearly flagging single orders vs. multi-quantity parcels (`ALERT: PACK X PCS`) for your dispatch audit."
  }
];
---

<Layout
  title="Meesho Excel to Dispatch Manifest & AWB Register Exporter Free"
  description="Export Meesho & Flipkart daily shipping label batches into clean Excel/CSV handover registers with 1 click. Zero scientific notation on AWBs and 100% offline security."
  canonicalUrl="https://smartlabelcrop.in/meesho-excel-to-manifest"
  keywords="meesho excel manifest export, meesho dispatch register, meesho handover sheet csv, meesho awb excel download, ecommerce dispatch manifest generator"
  faqItems={manifestFaqs}
>
  <Navbar />
  
  <main class="flex-1">
    <!-- Tailored Manifest Hero Header -->
    <section class="pt-12 pb-6 bg-gradient-to-b from-neutral-100/70 via-white to-white dark:from-neutral-900/40 dark:via-[#0A0A0A] dark:to-[#0A0A0A] border-b border-neutral-200 dark:border-neutral-800">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-800 px-3 py-1 text-xs font-semibold text-neutral-800 dark:text-neutral-200 mb-4">
          📥 1-CLICK EXCEL DISPATCH MANIFEST
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-[#0A0A0A] dark:text-white font-display">
          Export Daily Meesho Labels to Excel Manifest
        </h1>
        <p class="mt-3 text-sm sm:text-base text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto">
          Never manually type AWB tracking numbers into spreadsheets again. Extract AWBs, couriers, SKUs, and multi-piece flags into formatted Excel registers instantly.
        </p>
      </div>
    </section>

    <!-- Interactive Cropper Workspace Component -->
    <CropperWorkspace />

    <!-- Manifest Value Pillars -->
    <section class="py-16 bg-[#FAFAFA] dark:bg-[#111111] border-b border-neutral-200 dark:border-neutral-800">
      <div class="mx-auto max-w-5xl px-4 sm:px-6">
        <h2 class="text-2xl sm:text-3xl font-bold text-center text-[#0A0A0A] dark:text-white font-display mb-10">
          Why Top Sellers Export Handover Manifests Daily
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#161616] p-5 shadow-2xs">
            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 font-bold text-sm mb-3">
              🛡️
            </div>
            <h3 class="font-bold text-sm text-[#0A0A0A] dark:text-white">Proof of Handover</h3>
            <p class="mt-1.5 text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">
              When a courier claims a parcel was never handed over, your timestamped manifest register is undeniable proof for seller support claims.
            </p>
          </div>

          <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#161616] p-5 shadow-2xs">
            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 font-bold text-sm mb-3">
              ⚡
            </div>
            <h3 class="font-bold text-sm text-[#0A0A0A] dark:text-white">Zero Scientific Notation</h3>
            <p class="mt-1.5 text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">
              Long 12 to 18-digit AWBs are escaped with text formulas so Excel displays every single digit cleanly without converting them to 1.48E+11.
            </p>
          </div>

          <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#161616] p-5 shadow-2xs">
            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 font-bold text-sm mb-3">
              📊
            </div>
            <h3 class="font-bold text-sm text-[#0A0A0A] dark:text-white">Reconciliation Ready</h3>
            <p class="mt-1.5 text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">
              Easily VLOOKUP your daily dispatch register against weekly Meesho settlement sheets to audit deductions and returned packages.
            </p>
          </div>
        </div>
      </div>
    </section>

    <PrinterSetupGuide />
    <WhyFreeAndComparison />
  </main>

  <FooterDirectory />
</Layout>
